# Public mirror — copyright-bearing game data MUST NOT be committed.
# Anything that derives from amiga-data/, pc-data/, or the ADF disks is
# excluded. Source files (tools/*.py, build.sh, declarative configs)
# live here; the user supplies their own legitimate game files locally.
#
# Note: amiga-data/, pc-data/, disks/, boot-infra/, monkey2-hd/, dist/,
# preview/, extracted-pc-pngs/, and the descumm-derived JSON inputs
# never make it into this repo. They're either user-supplied or
# regenerated locally by build.sh.

# External tool clones / built binaries — fetch/build locally, not part of repo
tools/adflib/
tools/adfcopy
tools/adfreplace
tools/jmonkey/
tools/scummvm/
tools/scummvm-patched/
tools/scummvm-tools/
tools/PyTexturePacker/
tools/lha-jca/
tools/.venv/

# Pre-decoded pristine asset cache (rebuilt from amiga-data/ at start of build.sh)
tools/pristine_cache.pkl

# Generated previews — regeneratable from sources, large; don't bloat the repo
preview/

# Mutated each build by encode_global_guybrush.py + encode_global_extras.py
# (build_actor_palette.py regenerates the initial structure each run)
tools/global_actor_palette.json

# Diagnostic-only descumm scans — not used by the inject pipeline
tools/deep_costume_refs.json
tools/actor_room_refs.json

# scummvm-test is a symlink users create locally to point at monkey2-hd/
scummvm-test

# Regenerated by tools/extract_pc_pngs.py (Stage 1a in build.sh) from
# pc-data/MONKEY2.001 — pixel-identical to MISE Explorer output. Don't
# track (~1100 PNGs, copyrighted PC art).
extracted-pc-pngs/

# Descumm-derived JSON inputs — content-stable scans of pristine SCUMM
# bytecode in amiga-data/. Build.sh's Stage 1b' regenerates the two the
# build pipeline actually consumes (costume_refs.json, talk_colors_survey.json).
# The other two (asset_refs_v2.json, slot_usage_survey.json) are diagnostic-
# only and built on demand by their respective survey scripts. None of these
# belong in a public repo since they derive from copyrighted SCUMM bytecode.
tools/costume_refs.json
tools/talk_colors_survey.json
tools/asset_refs_v2.json
tools/slot_usage_survey.json

# Family palettes are regenerated by build_family_palette.py in Stage 2b
# from PC source pixels. Each is just 32 RGB triples + lock flags but it's
# derived from copyrighted PC art, so don't ship.
tools/shared_palettes/*.json
!tools/shared_palettes/.gitkeep

# Build output: inject_room writes patched monkey2.NNN here (regen from
# amiga-data/ via build.sh). Also: copyrighted game data.
monkey2-hd/

# User-supplied: original 1992 Amiga MI2 floppy ADFs. build.sh Stage 3
# reads Disk 1 to extract Workbench infrastructure for the HDF dist.
# Copyrighted; user must supply from their own legitimate copy.
disks/*.adf
!disks/README.md

# Game data — user supplies these from their own legitimate copy.
amiga-data/
pc-data/
boot-infra/

# Python / OS
**/__pycache__/
*.pyc
.DS_Store
.idea/
.vscode/
*.swp

# Build outputs
build/
out/
target/
*.class
*.jar

# Distribution artifacts — regenerated by build.sh
dist/
monkey2-hd.hdf
*.lha
